<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Droni" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#071120</item>
        <item name="android:statusBarColor">#071120</item>
        <item name="android:windowBackground">#071120</item>
    </style>
    <style name="Theme.Droni.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#071120</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_droni_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Droni</item>
    </style>
</resources>
